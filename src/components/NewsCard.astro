---
import Thumb from './Thumb.astro';
import Badge from './Badge.astro';
import { timeAgo } from '../lib';
const { item } = Astro.props;
const d = item.data;
---
<article class="card" data-cat={d.category} data-text={`${d.title} ${d.source} ${d.summary}`.toLowerCase()}>
  <a href={d.sourceUrl} target="_blank" rel="noopener nofollow" aria-label={d.title}><Thumb image={d.image} category={d.category} alt="" /></a>
  <div class="card-body">
    <div class="meta"><Badge category={d.category} /><span>{d.source}</span></div>
    <h3><a href={d.sourceUrl} target="_blank" rel="noopener nofollow">{d.title}</a></h3>
    {d.summary && <p>{d.summary}</p>}
    <div class="meta"><time datetime={d.pubDate.toISOString()}>{timeAgo(d.pubDate)}</time></div>
  </div>
</article>
