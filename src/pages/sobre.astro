---
import Base from '../layouts/Base.astro';
import Creator from '../components/Creator.astro';
---
<Base title="Sobre" description="Conheça a BragaTech e o seu criador, José Raul Bragagnolo Filho.">
  <div class="container">
    <section class="brand-hero" style="padding-bottom:0">
      <div class="wrap">
        <div>
          <span class="kicker">Sobre o portal</span>
          <h1>Tecnologia que informa. <em>Segurança que protege.</em></h1>
          <p>A BragaTech reúne, todos os dias, as notícias mais relevantes sobre inteligência artificial, cibersegurança, cloud, infraestrutura e o mercado de tecnologia, com análises práticas de quem coordena ambientes críticos de TI.</p>
        </div>
        <img src="/logo-full.webp" alt="Logo BragaTech" width="480" height="425" class="logo-big" />
      </div>
    </section>
    <section><Creator full /></section>
  </div>
</Base>
