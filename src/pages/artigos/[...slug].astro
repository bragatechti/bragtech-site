---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import Thumb from '../../components/Thumb.astro';
import Badge from '../../components/Badge.astro';
import Creator from '../../components/Creator.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { getArtigos, readingTime } from '../../lib';

export async function getStaticPaths() {
  const posts = await getArtigos();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
const minutes = readingTime(post.body ?? '');
const url = new URL(`/artigos/${post.id}/`, Astro.site).href;
const schema = {
  '@context': 'https://schema.org',
  '@type': 'Article',
  headline: post.data.title.slice(0, 110),
  description: post.data.description,
  datePublished: post.data.pubDate.toISOString(),
  dateModified: (post.data.updatedDate ?? post.data.pubDate).toISOString(),
  author: { '@type': 'Person', name: 'Raul Bragagnolo', url: 'https://www.linkedin.com/in/joseraulbragagnolofilho/' },
  publisher: { '@type': 'Organization', name: 'BragaTech', url: `${Astro.site}`, logo: { '@type': 'ImageObject', url: new URL('/logo-full.webp', Astro.site).href } },
  image: [post.data.cover && post.data.cover.startsWith('https://') ? post.data.cover : new URL('/logo-full.webp', Astro.site).href],
  mainEntityOfPage: { '@type': 'WebPage', '@id': url },
  inLanguage: 'pt-BR',
  articleSection: post.data.category,
  keywords: post.data.tags.join(', '),
};
---
<Base title={post.data.title} description={post.data.description} type="article" image={post.data.cover} schema={schema}>
  <article class="article">
    <div class="page-head" style="padding-bottom:0">
      <div class="meta"><Badge category={post.data.category} />{post.data.category === 'politica' && <span class="badge" style="--c:#ef4444">Opinião</span>}<span>Por <strong>Raul Bragagnolo</strong></span><span class="dot"></span><FormattedDate date={post.data.pubDate} /><span class="dot"></span><span>{minutes} min de leitura</span></div>
      <h1>{post.data.title}</h1>
      <p>{post.data.description}</p>
    </div>
    <div class="article-cover"><Thumb image={post.data.cover} category={post.data.category} eager /></div>
    <div class="prose"><Content /></div>
    {post.data.tags.length > 0 && <div class="chips" style="margin-top:2rem">{post.data.tags.map((t) => <span class="chip">#{t}</span>)}</div>}
  </article>
  <section><div class="container narrow"><Creator /></div></section>
</Base>
