---
import { render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { categoryName } from '../../consts';
import { getArtigos } from '../../lib';

export async function getStaticPaths() {
  const posts = await getArtigos();
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description} type="article">
  <article class="article container">
    <div class="meta">
      <a class="badge" href={`/categoria/${post.data.category}/`}>{categoryName(post.data.category)}</a>
      <FormattedDate date={post.data.pubDate} />
      {post.data.updatedDate && <span>· atualizado em <FormattedDate date={post.data.updatedDate} /></span>}
    </div>
    <h1>{post.data.title}</h1>
    <p class="meta" style="font-size:1.05rem">{post.data.description}</p>
    <div class="prose"><Content /></div>
    {post.data.tags.length > 0 && (
      <p class="meta" style="margin-top:2rem">Tags: {post.data.tags.map((t) => <span class="badge">{t}</span>)}</p>
    )}
  </article>
</Base>
